{
  "name": "sinwan-ui",
  "version": "1.0.0",
  "description": "CLI for the sinwan-ui component registry: copies components into your Sinwan app, like shadcn.",
  "author": "Mohammed Ben Cheikh",
  "license": "MIT",
  "homepage": "https://sinwanjs.com",
  "bugs": "https://github.com/sinwanjs/sinwan-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinwanjs/sinwan-ui.git"
  },
  "type": "module",
  "bin": {
    "sinwan-ui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "sinwan",
    "ui",
    "components",
    "registry",
    "cli",
    "shadcn",
    "tailwind"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test --coverage ./__tests__",
    "typecheck": "bunx tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@clack/prompts": "^0.10.0",
    "@types/bun": "latest",
    "kolorist": "^1.8.0",
    "typescript": "^5.9.3"
  }
}
