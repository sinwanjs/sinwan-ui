{
  "name": "sinwan-ui",
  "version": "0.1.0",
  "description": "Component library of the Sinwan ecosystem, providing a comprehensive set of customizable, accessible, and production-ready UI components for modern applications.",
  "author": "Mohammed Ben Cheikh",
  "license": "MIT",
  "homepage": "https://sinwanjs.com",
  "bugs": "https://github.com/sinwanjs/sinwan-ui/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinwanjs/sinwan-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/global.css",
    "./styles/global.css": "./src/styles/global.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "keywords": [
    "sinwan",
    "ui",
    "components",
    "tailwind",
    "theming",
    "dark-mode"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test --coverage ./__tests__",
    "typecheck": "bunx tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "sinwan": ">=1.4.0 <2.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/table-core": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^0.544.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-plugin-sinwan": "^0.3.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}